        <mxCell id="lg_amd" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#E7E7E7;strokeColor=#666666;fontSize=12;" value="AMD IP" vertex="1">
          <mxGeometry height="40" width="250" x="300" y="1295" as="geometry" />
        </mxCell>
        <mxCell id="lg_e" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;" value="Flechas: &lt;font color=&#39;#1E63A6&#39;&gt;&lt;b&gt;azul&lt;/b&gt;&lt;/font&gt; AXI-Stream (32 b = {im, re}) · &lt;font color=&#39;#4A5568&#39;&gt;&lt;b&gt;gris grueso&lt;/b&gt;&lt;/font&gt; AXI4 memory-mapped · gris punteado AXI-Lite · &lt;font color=&#39;#A9521A&#39;&gt;&lt;b&gt;naranja punteado&lt;/b&gt;&lt;/font&gt; interrupción · &lt;font color=&#39;#7A5C2E&#39;&gt;&lt;b&gt;marrón&lt;/b&gt;&lt;/font&gt; DDR4" vertex="1">
          <mxGeometry height="50" width="1030" x="40" y="1345" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;" value="&lt;b&gt;Flujo de una trama&lt;/b&gt;&lt;br&gt;① Una vez por sesión: ps_sense calcula U&#39;&#39; y la deja en la DDR.&lt;br&gt;② El PS carga el k-space de la trama&lt;br&gt;③ HP0 → DMA 1 → fft2d → DMA 1 → HP3: ~1,6 GB/s&lt;br&gt;④ A_l (1,6 GB/s) por HP0 y U&#39;&#39;&amp;nbsp; por HP1 → unfold → cordic_mag → HP3 (0,2 GB/s).&lt;br&gt;⑤ IRQ: el PS lee la imagen (sale bit-reversed: reordenar en el PS o con direcciones en el DMA).&lt;br&gt;Un puerto HP de 128 b a 200 MHz da 3,2 GB/s teóricos. Presupuesto: 10,5 ms (FFT) + 10,5 ms (desplegado) = 21 ms de 50 ms." vertex="1">
          <mxGeometry height="210" width="660" x="1100" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="e_sense_ddrc" edge="1" parent="1" source="ps_sense" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A5568;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="ddrc" value="① U&#39;&#39;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="250" />
              <mxPoint x="700" y="235" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_app_ddrc" edge="1" parent="1" source="ps_app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A5568;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="ddrc" value="② k-space · ⑤ imagen">
