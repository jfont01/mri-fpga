      Ports		      [2, 1]
      Position		      [645, 360, 665, 380]
      ShowName		      off
      IconShape		      "round"
      Inputs		      "|+-"
      InputSameDT	      off
      OutDataTypeMode	      "Inherit via internal rule"
    }
    Line {
      SrcBlock		      "Gateway In"
      SrcPort		      1
      Points		      [0, 0; 60, 0]
      Branch {
	Labels			[1, 0]
	DstBlock		"4 stage CIC filter, decimation by 16 - System"
" 1"
	DstPort			1
      }
      Branch {
	Points			[0, 105]
	Branch {
	  Points		  [0, 80]
	  DstBlock		  "Gateway Out1"
	  DstPort		  1
	}
	Branch {
	  DstBlock		  "4 stage CIC filter, decimation by 16 - Syst"
"em 2"
	  DstPort		  1
	}
      }
    }
    Line {
      SrcBlock		      "4 stage CIC filter, decimation by 16 - System 1"
      SrcPort		      1
      DstBlock		      "Gateway Out"
      DstPort		      1
    }
    Line {
      Name		      "CIC System 1 Output"
      Labels		      [0, 0]
      SrcBlock		      "Gateway Out"
      SrcPort		      1
      Points		      [0, 0; 25, 0]
      Branch {
	DstBlock		"Scope"
	DstPort			1
      }
      Branch {
	Points			[0, 50]
	DstBlock		"Sum1"
	DstPort			1
      }
    }
    Line {
      SrcBlock		      "Sine Wave"
      SrcPort		      1
      Points		      [10, 0; 0, 5]
      DstBlock		      "Sum"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Random\nNumber"
      SrcPort		      1
      Points		      [45, 0]
      DstBlock		      "Sum"
      DstPort		      2
    }
    Line {
      SrcBlock		      "Sum"
      SrcPort		      1
      DstBlock		      "Gateway In"
      DstPort		      1
    }
    Line {
      SrcBlock		      "4 stage CIC filter, decimation by 16 - System 2"
      SrcPort		      1
      DstBlock		      "Gateway Out2"
