      Name		      "23 bit input (Noisy Sine Wave)"
      Labels		      [0, 0]
      SrcBlock		      "Gateway Out1"
      SrcPort		      1
      Points		      [400, 0]
      DstBlock		      "Scope"
      DstPort		      4
    }
    Line {
      SrcBlock		      "Sum1"
      SrcPort		      1
      Points		      [295, 0; 0, -10]
      DstBlock		      "Scope"
      DstPort		      3
    }
    Annotation {
      Name		      "This is the last in a sequence of examples towa"
"rds building a 4 stage Cascaded Integrator-Comb (CIC) filter. \nIn this examp"
"le the maximum bit width is demonstrated and the filter is shown to overflow "
"at certain stages.\n\n(1) Run the system and observe the output in the scope "
"window\n\n(2) In the duplicate system (system 2), try increasing the number o"
"f bits in a component, run the system and view the results in the analysis wi"
"ndow. \nTry also decreasing the wordlength (just by 1 bit) in the last integr"
"ator before the downsampler and view the difference between the two signals i"
"n the scope window. \nObserve the results in the scope window for different w"
"ordlengths at different points in the filter cascade."
      Position		      [41, 156]
      HorizontalAlignment     "left"
      FontName		      "Arial"
      FontSize		      14
    }
    Annotation {
      Name		      "Decimating CIC Filter"
      Position		      [395, 40]
      FontName		      "Arial Black"
      FontSize		      18
      FontAngle		      "italic"
    }
    Annotation {
      Name		      "CIC Decimation Filter Parameters:\nNumber of Co"
"mb Sections: 4\nDecimation Factor: 16\nDelays per Comb: 1\nBit Width @Input ("
"before first stage): 23\nBit Width @Output: 39\nMaximum Bit Width: 39"
      Position		      [67, 509]
      HorizontalAlignment     "left"
      FontName		      "Arial"
      FontSize		      14
    }
    Annotation {
      Name		      "CIC System 2 Output\n"
      Position		      [758, 421]
    }
    Annotation {
      Name		      "System1 minus System 2"
      Position		      [743, 366]
    }
  }
}
