	Points			[0, -90]
	DstBlock		"Mux"
	DstPort			2
      }
    }
    Line {
      SrcBlock		      "Mux"
      SrcPort		      1
      DstBlock		      "Buffer"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Buffer"
      SrcPort		      1
      DstBlock		      "Spectrum\nScope"
      DstPort		      1
    }
    Annotation {
      Name		      "------------Integrator----------"
      Position		      [371, 304]
    }
    Annotation {
      Name		      "In this exercise, we now build a CIC filter wit"
"h a decimation factor of R=16 and N=4 sections. \nThis filter is designed to "
"decimate from a sampling rate of 10MHz down to 625kHz for a pass band of 78.1"
"25kHz. \nWe also demonstrate a complete CIC filtering token.\n\n(1) Observe i"
"n the FFT scope the non zero dB gain of the CIC filter.  \nThis may be compen"
"sated for using a right shift of log2(R^N) = 16 bits\n\n(2) Run the system an"
"d observe the frequency response of the two signals.  Although this is the de"
"cimated response, you should\nstill be able to see passband 'droop' \n\n(3) O"
"bserve that the output of the CIC filtering block is not the same, but that t"
"he shape of each FFT is virtually identical.\nThis is because the timing stru"
"cture used in the CIC block is slightly different. "
      Position		      [66, 151]
      HorizontalAlignment     "left"
      FontName		      "Arial"
      FontSize		      14
    }
    Annotation {
      Name		      "Decimating CIC Filter"
      Position		      [395, 40]
      FontName		      "Arial Black"
      FontSize		      18
      FontAngle		      "italic"
    }
    Annotation {
      Name		      "------------Integrator----------"
      Position		      [506, 304]
    }
    Annotation {
      Name		      "------------Integrator----------"
      Position		      [641, 304]
    }
    Annotation {
      Name		      "------------Integrator----------"
      Position		      [776, 304]
    }
    Annotation {
      Name		      "--------------Comb------------"
      Position		      [826, 484]
    }
    Annotation {
      Name		      "--------------Comb------------"
      Position		      [656, 484]
    }
    Annotation {
      Name		      "--------------Comb------------"
      Position		      [486, 484]
    }
    Annotation {
      Name		      "--------------Comb------------"
      Position		      [311, 484]
    }
    Annotation {
      Name		      "Cascade of 4 integrators with registers positio"
"ned to minimise critical path"
      Position		      [580, 281]
    }
    Annotation {
      Name		      "Cascade of 4 combs with pipelining registers be"
"tween each comb"
      Position		      [570, 401]
    }
  }
}
